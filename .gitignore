iosApp/iosApp-e2e.xcodeproj/
iosApp/*.xcworkspace/
**/xcuserdata/
**/*.xcuserdatad/
**/.swiftpm/
DerivedData/
# xcodebuild -derivedDataPath output (scripts/build-ios.sh and the e2e run)
iosApp/build/
iosApp/build-e2e/

# --- Swift Package Manager ---
.build/
Package.resolved

# --- Release artifacts ---
